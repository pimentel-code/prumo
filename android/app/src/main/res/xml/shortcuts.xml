<?xml version="1.0" encoding="utf-8"?>
<!-- Atalhos ao segurar o dedo no ícone do Prumo. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/atalho_falar"
        android:shortcutId="falar"
        android:shortcutLongLabel="@string/atalho_falar_longo"
        android:shortcutShortLabel="@string/atalho_falar">
        <intent
            android:action="io.github.pimentelcode.prumo.FALAR"
            android:targetClass="io.github.pimentelcode.prumo.MainActivity"
            android:targetPackage="io.github.pimentelcode.prumo" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/atalho_anotar"
        android:shortcutId="anotar"
        android:shortcutLongLabel="@string/atalho_anotar_longo"
        android:shortcutShortLabel="@string/atalho_anotar">
        <intent
            android:action="io.github.pimentelcode.prumo.ANOTAR"
            android:targetClass="io.github.pimentelcode.prumo.MainActivity"
            android:targetPackage="io.github.pimentelcode.prumo" />
    </shortcut>
</shortcuts>
