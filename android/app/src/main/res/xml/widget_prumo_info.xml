<?xml version="1.0" encoding="utf-8"?>
<!-- 4 x 1 na tela principal. Atualiza a cada 30 min (o mínimo do Android) e
     também sempre que algo é salvo no app. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_descricao"
    android:initialLayout="@layout/widget_prumo"
    android:minWidth="250dp"
    android:minHeight="50dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="50dp"
    android:previewLayout="@layout/widget_prumo"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
